# Supabase (MVP database, auth, storage — see docs/TDD.md §2.3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build OAuth/email-confirmation redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Generation Engine (docs/TDD.md §2.5). Set OPENAI_API_KEY for a quick
# start with a standard OpenAI key — this is a temporary substitute; revert
# to Azure OpenAI (AZURE_OPENAI_*) before any real federal customer, for
# data-residency/enterprise terms — see docs/PRD.md §11. If OPENAI_API_KEY
# is set, it takes priority over the Azure OpenAI vars below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Optional; defaults to 2024-10-21 if unset. For newer model deployments,
# get the exact value from Azure OpenAI Studio's "View Code" sample for
# this specific deployment — API version requirements vary by model.
AZURE_OPENAI_API_VERSION=

# Stripe (billing — Sprint 3+, not wired until then)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (error tracking — docs/TDD.md §2.9)
NEXT_PUBLIC_SENTRY_DSN=
