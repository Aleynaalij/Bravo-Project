# Supabase (MVP database, auth, storage — see docs/TDD.md §2.3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build OAuth/email-confirmation redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Generation Engine (docs/TDD.md §2.5). Set OPENAI_API_KEY for a quick
# start with a standard OpenAI key — this is a temporary substitute; revert
# to Azure OpenAI (AZURE_OPENAI_*) before any real federal customer, for
# data-residency/enterprise terms — see docs/PRD.md §11. If OPENAI_API_KEY
# is set, it takes priority over the Azure OpenAI vars below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Optional; defaults to 2024-10-21 if unset. For newer model deployments,
# get the exact value from Azure OpenAI Studio's "View Code" sample for
# this specific deployment — API version requirements vary by model.
AZURE_OPENAI_API_VERSION=

# Stripe (billing — docs/PRD.md FR-15). STRIPE_SECRET_KEY from the Stripe
# Dashboard's API keys page. STRIPE_WEBHOOK_SECRET from the webhook
# endpoint's settings once /api/billing/webhook is registered as an
# endpoint (Stripe Dashboard > Developers > Webhooks). The two price IDs
# come from creating Products/Prices in the Dashboard first — Consultant
# $49/mo, Professional $99/mo per the PRD; this app can't create them
# itself.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CONSULTANT=
STRIPE_PRICE_ID_PROFESSIONAL=

# Sentry (error tracking — docs/TDD.md §2.9). The SDK is wired up
# (src/instrumentation.ts, src/instrumentation-client.ts,
# src/sentry.*.config.ts) and no-ops safely with this unset — set a real
# DSN from a Sentry project's Settings > Client Keys page to start
# receiving events. Optional SENTRY_AUTH_TOKEN (+ SENTRY_ORG/SENTRY_PROJECT
# via next.config.ts) enables source-map upload at build time; unset today.
NEXT_PUBLIC_SENTRY_DSN=

# Generation job queue (src/lib/generation/jobs.ts, vercel.json's cron
# entry). Vercel signs its own cron requests with this exact value as a
# Bearer token — set it in Vercel's project env vars (any random string;
# `openssl rand -hex 32` is fine) and Vercel wires the header up
# automatically, nothing else to configure. Left unset, the cron route
# fails closed (rejects every request) rather than running unauthenticated.
CRON_SECRET=
